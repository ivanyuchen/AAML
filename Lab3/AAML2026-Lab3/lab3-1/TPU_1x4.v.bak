`timescale 1ns/10ps
`include "PE.v"

// Row-stationary convolution, C[oy][ox] = sum A[oy+ky][ox+kx] * B[ky][kx].
// A is column major (one read = 4 vertical pixels), so a "row" here is a
// whole kernel column kx.  Four PEs each store one complete kernel row
// (kx = 4g+k, all ky) and stay fixed while the input columns of image row oy
// stream by.  The input is broadcast to all PEs; each PE needs KT words of
// an input column to finish its row product, then the partial sums move
// PE0 -> PE3.  PE3 yields one output per column step, accumulated in obuf.
// After all kernel groups g of an output row, obuf is written to C.
module TPU(
    input              clk,
    input              rst_n,
    input              in_valid,
    input      [7:0]   M,
    input      [7:0]   N,
    output reg         busy,

    output reg         A_ram_en,
    output reg [15:0]  A_index,
    input      [31:0]  A_data_out,

    output reg         B_ram_en,
    output reg [15:0]  B_index,
    input      [31:0]  B_data_out,

    output reg         C_ram_en,
    output reg         C_wr_en,
    output reg [15:0]  C_index,
    output reg [127:0] C_data_in,
    input      [127:0] C_data_out
);

localparam IDLE = 3'd0, WL = 3'd1, ST = 3'd2, DR = 3'd3, WR = 3'd4, FIN = 3'd5;

reg [2:0]  st;
reg [7:0]  M_r, N_r;
reg [15:0] L_r, T_r, KT_r, G_r;     // output size, output tiles, words per kernel row, kernel row groups
reg [15:0] cnt, oy, t, g;
reg [1:0]  kk;

wire [15:0] kx   = {g[13:0], 2'b00} + {14'd0, kk};      // kernel row being loaded
wire [15:0] col  = {g[13:0], 2'b00} + cnt;              // input column being streamed
wire [15:0] aidx = col * ({8'd0, M_r} + 16'd3) + oy + {t[13:0], 2'b00};
wire [15:0] bidx = t * {8'd0, N_r} + kx;

wire g_last = (g == G_r  - 16'd1);
wire t_last = (t == KT_r - 16'd1);
wire y_last = (oy == L_r - 16'd1);

// ---------------- PE chain ----------------
reg  [3:0]  ldsel;                  // which PE stores the weight word being read
reg  [5:0]  lda;
reg  [31:0] xr;                     // input word, broadcast to all PEs
reg         pf0, pl0, pf1, pl1;     // first / last word of a column, pipeline aligned
reg  [5:0]  pt0, pt1;
wire [31:0] wdata = B_ram_en ? B_data_out : 32'd0;
wire [31:0] ps0, ps1, ps2, ps3, px0, px1, px2, px3;

PE pe0(.clk(clk), .rst_n(rst_n), .load(ldsel[0]), .load_addr(lda), .filter_in(wdata),
       .tsel(pt1), .first(pf1), .last(pl1), .input_val(xr),
       .psum_in(32'd0), .pass_val(px0), .partial_sum(ps0));
PE pe1(.clk(clk), .rst_n(rst_n), .load(ldsel[1]), .load_addr(lda), .filter_in(wdata),
       .tsel(pt1), .first(pf1), .last(pl1), .input_val(px0),
       .psum_in(ps0), .pass_val(px1), .partial_sum(ps1));
PE pe2(.clk(clk), .rst_n(rst_n), .load(ldsel[2]), .load_addr(lda), .filter_in(wdata),
       .tsel(pt1), .first(pf1), .last(pl1), .input_val(px1),
       .psum_in(ps1), .pass_val(px2), .partial_sum(ps2));
PE pe3(.clk(clk), .rst_n(rst_n), .load(ldsel[3]), .load_addr(lda), .filter_in(wdata),
       .tsel(pt1), .first(pf1), .last(pl1), .input_val(px2),
       .psum_in(ps2), .pass_val(px3), .partial_sum(ps3));

// ---------------- output accumulation ----------------
reg [31:0] obuf [0:255];
reg        v0, v1, v2, f0, f1, f2;  // output valid / first-group flags, aligned with the pipeline
reg [7:0]  ox0, ox1, ox2;

wire [7:0] wbase = {cnt[5:0], 2'b00};
wire [3:0] wmask = {({8'd0, wbase} + 16'd0) < L_r, ({8'd0, wbase} + 16'd1) < L_r,
                    ({8'd0, wbase} + 16'd2) < L_r, ({8'd0, wbase} + 16'd3) < L_r};

always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        st <= IDLE; busy <= 1'b0;
        A_ram_en <= 1'b0; B_ram_en <= 1'b0; C_ram_en <= 1'b0; C_wr_en <= 1'b0;
        A_index <= 16'd0; B_index <= 16'd0; C_index <= 16'd0; C_data_in <= 128'd0;
        M_r <= 8'd0; N_r <= 8'd0; L_r <= 16'd0; T_r <= 16'd0; KT_r <= 16'd0; G_r <= 16'd0;
        cnt <= 16'd0; oy <= 16'd0; t <= 16'd0; g <= 16'd0; kk <= 2'd0;
        ldsel <= 4'd0; lda <= 6'd0; xr <= 32'd0;
        pf0 <= 1'b0; pl0 <= 1'b0; pf1 <= 1'b0; pl1 <= 1'b0; pt0 <= 6'd0; pt1 <= 6'd0;
        v0 <= 1'b0; v1 <= 1'b0; v2 <= 1'b0; f0 <= 1'b0; f1 <= 1'b0; f2 <= 1'b0;
        ox0 <= 8'd0; ox1 <= 8'd0; ox2 <= 8'd0;
    end
    else begin
        A_ram_en <= 1'b0; B_ram_en <= 1'b0; C_ram_en <= 1'b0; C_wr_en <= 1'b0;
        ldsel <= 4'd0;
        pf0 <= 1'b0; pl0 <= 1'b0; v0 <= 1'b0;

        // read data of the previous cycle's request
        xr <= A_ram_en ? A_data_out : 32'd0;
        pf1 <= pf0; pl1 <= pl0; pt1 <= pt0;
        v1 <= v0; v2 <= v1; f1 <= f0; f2 <= f1; ox1 <= ox0; ox2 <= ox1;
        if (v2) obuf[ox2] <= (f2 ? 32'd0 : obuf[ox2]) + ps3;

        case (st)
        IDLE: if (in_valid) begin
            M_r  <= M;
            N_r  <= N;
            L_r  <= {8'd0, M} - {8'd0, N} + 16'd1;
            T_r  <= ({8'd0, M} - {8'd0, N} + 16'd4) >> 2;
            KT_r <= ({8'd0, N} + 16'd3) >> 2;
            G_r  <= ({8'd0, N} + 16'd3) >> 2;
            cnt <= 16'd0; oy <= 16'd0; t <= 16'd0; g <= 16'd0; kk <= 2'd0;
            busy <= 1'b1;
            st   <= WL;
        end

        // store four whole kernel rows (kx = 4g..4g+3) into the PEs
        WL: begin
            B_ram_en <= (kx < {8'd0, N_r});
            B_index  <= bidx;
            ldsel    <= 4'd1 << kk;
            lda      <= t[5:0];
            if (!t_last) t <= t + 16'd1;
            else begin
                t <= 16'd0;
                if (kk == 2'd3) begin kk <= 2'd0; st <= ST; end
                else kk <= kk + 2'd1;
            end
        end

        // stream L+3 input columns, KT words each, through the PEs
        ST: begin
            A_ram_en <= (col < {8'd0, M_r});
            A_index  <= aidx;
            pf0 <= (t == 16'd0);
            pl0 <= t_last;
            pt0 <= t[5:0];
            v0  <= t_last && (cnt >= 16'd3);
            ox0 <= cnt[7:0] - 8'd3;
            f0  <= (g == 16'd0);
            if (!t_last) t <= t + 16'd1;
            else begin
                t <= 16'd0;
                if (cnt != L_r + 16'd2) cnt <= cnt + 16'd1;
                else begin
                    cnt <= 16'd0;
                    if (!g_last) begin g <= g + 16'd1; st <= WL; end
                    else begin g <= 16'd0; st <= DR; end
                end
            end
        end

        // let the last outputs reach obuf
        DR: if (cnt == 16'd2) begin cnt <= 16'd0; st <= WR; end
            else cnt <= cnt + 16'd1;

        // write one output row, 4 results per word
        WR: begin
            C_ram_en  <= 1'b1;
            C_wr_en   <= 1'b1;
            C_index   <= oy * T_r + cnt;
            C_data_in <= {wmask[3] ? obuf[wbase]        : 32'd0,
                          wmask[2] ? obuf[wbase + 8'd1] : 32'd0,
                          wmask[1] ? obuf[wbase + 8'd2] : 32'd0,
                          wmask[0] ? obuf[wbase + 8'd3] : 32'd0};
            if (cnt == T_r - 16'd1) begin
                cnt <= 16'd0;
                if (y_last) st <= FIN;
                else begin oy <= oy + 16'd1; st <= WL; end
            end
            else cnt <= cnt + 16'd1;
        end

        FIN: begin busy <= 1'b0; st <= IDLE; end

        default: st <= IDLE;
        endcase
    end
end

endmodule
