{
  "version": 4,
  "configurations": [
    {
      "name": "Lab5 RISC-V",
      "compilerPath": "/opt/riscv/bin/riscv64-unknown-elf-g++",
      "compilerArgs": [
        "-march=rv32im",
        "-mabi=ilp32"
      ],
      "cStandard": "c11",
      "cppStandard": "c++11",
      "includePath": [
        "${workspaceFolder}/Platform/sw",
        "${workspaceFolder}/Platform/sw/app",
        "${workspaceFolder}/Platform/sw/project",
        "${workspaceFolder}/Platform/build/sw/generated",
        "${workspaceFolder}/Platform/build/sw/src",
        "${workspaceFolder}/Platform/build/sw/src/third_party/flatbuffers/include",
        "${workspaceFolder}/Platform/build/sw/src/third_party/gemmlowp",
        "${workspaceFolder}/Platform/build/sw/src/third_party/ruy",
        "${workspaceFolder}/tflite-micro",
        "${workspaceFolder}/tflite-micro/third_party/flatbuffers/include",
        "${workspaceFolder}/tflite-micro/third_party/gemmlowp",
        "${workspaceFolder}/tflite-micro/third_party/ruy"
      ],
      "defines": [
        "TFLM_MODEL_ENABLED=1",
        "MODEL_NAME=\"mobileViT_xxs.tflite\"",
        "TENSOR_ARENA_SIZE=8*1024*1024"
      ]
    }
  ]
}
